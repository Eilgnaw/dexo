    "forum.https_upgrade.failure.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The HTTPS address could not be verified. The saved HTTP forum remains disabled and was not changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证 HTTPS 地址。已保存的 HTTP 论坛仍保持禁用，且未被修改。"
          }
        }
      }
    },
    "forum.https_upgrade.failure.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS Upgrade Failed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS 升级失败"
          }
        }
      }
    },
    "forum.https_upgrade.message %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This saved forum uses insecure HTTP and is disabled. Dexo can anonymously check %@ instead. If the upgrade succeeds, saved login data will be removed and you will need to sign in again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此论坛使用不安全的 HTTP，现已禁用。Dexo 可以匿名检查 %@。升级成功后会移除已保存的登录数据，你需要重新登录。"
          }
        }
      }
    },
    "forum.https_upgrade.success.message %@" : {
      "localizations" : {
        "en" : {
